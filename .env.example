# Copy to .env.local (which git ignores) and fill in to enable optional features.

# Google Analytics 4 measurement id. Leave empty for no analytics.
VITE_GA_ID=

# Optional accounts (Supabase). Use the project URL and the publishable (anon) key.
# Never put the secret or service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
