# Copy to server/.env (which git ignores). Only the server reads these; never put them in the site's .env files.

# Password for the admin panel at /admin/. Leave empty to switch the panel off.
ADMIN_PASSWORD=

# Optional: a long random string that signs admin sessions, so they survive a restart.
SESSION_SECRET=

# Optional: show accounts in the admin panel. Use the Supabase project URL and a
# secret key (sb_secret_...) or the legacy service_role key. Keep it on the server.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Where to listen, and where to keep the usage counts (relative to server/).
PORT=8786
HOST=127.0.0.1
USAGE_DB=data/usage.db
